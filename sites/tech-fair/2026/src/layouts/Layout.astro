---
import BaseLayout from '@csss-site-events/ui/layouts/BaseLayout.astro';
import Footer from '@csss-site-events/ui/components/Footer.astro';
import Hero from '@csss-site-events/ui/components/Hero.astro';
import '@csss-site-events/ui/styles/font-faces/cal-sans.css';
import calSansFont from '@csss-site-events/ui/assets/fonts/cal-sans-v2-latin-regular.woff2?url';
import '../styles/font-faces/ancizar-serif.css';
import '../styles/font-faces/boldonse.css';
import '../styles/legacy-theme.css';
import ancizarSerifFont from '../assets/fonts/ancizar-serif-v8-latin-regular.woff2?url';
import boldonseFont from '../assets/fonts/boldonse-v1-latin-regular.woff2?url';
import Navbar from '../components/Navbar.astro';
import { navItems, siteConfig } from '../config/site.data';

interface Props {
  title: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  isFullHeightHero?: boolean;
}

const { title, heroImage, heroAlt, isFullHeightHero = false } = Astro.props;
const hasHero = heroImage || Astro.slots.hero;
---

<BaseLayout pageTitle={title} description={siteConfig.description}>
  <Fragment slot="head">
    <link rel="preload" href={ancizarSerifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={boldonseFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={calSansFont} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <Navbar title={title} items={navItems} />
  {
    hasHero ? (
      <Hero image={heroImage} alt={heroAlt} isFullHeight={isFullHeightHero}>
        <slot name="hero" />
      </Hero>
    ) : (
      <slot name="hero" />
    )
  }
  <main>
    <slot />
  </main>
  <Footer config={siteConfig} navItems={navItems} />
</BaseLayout>

<style is:global>
  .photo-container {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .photo {
    border-radius: var(--corner-radius);
    background-color: white;
    padding: var(--sp-2);
    width: 80%;
    height: auto;
    margin: 0 auto;
  }

  .photo > img {
    border-radius: var(--corner-radius);
  }
</style>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    padding-bottom: var(--sp-6);
  }

  footer {
    margin-top: var(--sp-6);
  }
</style>
