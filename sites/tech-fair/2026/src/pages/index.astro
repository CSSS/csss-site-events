---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import CompanyFaq from '../components/CompanyFaq.astro';
import EventDetails from '../components/EventDetails.astro';
import Hero from '../components/Hero.astro';
import Section from '@csss-site-events/ui/components/Section.astro';
import StudentFaq from '../components/StudentFaq.astro';
import { siteConfig } from '../config/site.data';
import { Image } from 'astro:assets';
import boothImg from '../assets/booth.png';
---

<Layout title={siteConfig.title} isFullHeightHero>
  <Hero slot="hero" />
  <About />
  <Section><Image src={boothImg} alt="Tech Fair 2026" /></Section>
  <EventDetails />
  <StudentFaq />
  <CompanyFaq />
</Layout>
