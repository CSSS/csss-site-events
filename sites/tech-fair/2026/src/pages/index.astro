---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import CompanyFaq from '../components/CompanyFaq.astro';
import EventDetails from '../components/EventDetails.astro';
import Hero from '../components/Hero.astro';
import StudentFaq from '../components/StudentFaq.astro';
import { siteConfig } from '../config/site.data';
import { Image } from 'astro:assets';
import boothImg from '../assets/booth.png';
---

<Layout title={siteConfig.title} isFullHeightHero>
  <Hero slot="hero" />
  <About />
  <div><Image src={boothImg} alt="Tech Fair 2026" /></div>
  <EventDetails />
  <StudentFaq />
  <CompanyFaq />
</Layout>

<style>
  div {
    display: flex;
    justify-content: center;
  }
</style>
