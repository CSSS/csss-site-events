const imageClusters = Array.from({ length: Math.ceil(images.length / 3) }, (_, index) =>
  images.slice(index * 3, index * 3 + 3)
);
---

<Section id="gallery" title="Gallery">
  <div class="gallery">
    {imageClusters.map(cluster => <ImageCluster images={cluster} />)}
  </div>
</Section>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-8) var(--sp-6);
  }
</style>
