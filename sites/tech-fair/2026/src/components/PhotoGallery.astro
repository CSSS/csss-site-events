const imageClusters = Array.from({ length: Math.ceil(images.length / 3) }, (_, index) =>
  images.slice(index * 3, index * 3 + 3)
);
---

<section id="photo-gallery" class="photo-gallery">
  <div class="photo-gallery__heading"><h2>Check out our previous Tech Fair</h2></div>
  <ScrollList>
    {
      imageClusters.map(cluster => (
        <ScrollListItem>
          <ImageCluster images={cluster} />
        </ScrollListItem>
      ))
    }
  </ScrollList>
</section>

<style>
  .photo-gallery__heading {
    width: min(100% - var(--sp-6), var(--site-content-width));
    margin: 0 auto;
    display: flex;
    justify-content: center;
    padding-inline: var(--sp-2);
  }

  .photo-gallery :global(ul) {
    gap: var(--sp-8) var(--sp-6);
  }

  .photo-gallery :global(li) {
    display: flex;
    justify-content: center;
    inline-size: min(calc(100vw - var(--sp-6)), 36rem);
  }
</style>
