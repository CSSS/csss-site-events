---
import { ChevronDown, ExternalLink, Menu, X } from '@lucide/astro';
import type { NavItem } from '@csss-site-events/ui/types';

interface Props {
  title: string;
  items?: NavItem[];
}

const { title, items = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

function resolveHref(href: string) {
  if (/^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(href)) return href;
  if (href.startsWith('#')) return `${baseUrl}${href}`;
  return `${baseUrl}${href.replace(/^\.?\//, '')}`;
}
---

<header class="navbar" transition:persist="tech-fair-navbar">
  <div class="navbar__content">
    <a class="navbar__left" href={baseUrl}>
      <slot name="icon" />
      <span class="navbar__title">{title}</span>
    </a>
    <nav class="navbar__nav" id="tech-fair-navbar-menu">
      <div class="navbar__menu-header">
        <button class="navbar__close" type="button" aria-label="Close navigation">
          <X />
        </button>
      </div>
      <ul class="navbar__list">
        {
          items.map(item => (
            <li>
              {'href' in item ? (
                <a
                  class="navbar__link"
                  href={resolveHref(item.href)}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                  {item.external && <ExternalLink size={14} aria-hidden="true" />}
                </a>
              ) : (
                <div class="dropdown">
                  <button class="navbar__link" type="button" aria-expanded="false">
                    {item.label}
                    <ChevronDown size={16} />
                  </button>
                  <ul class="dropdown__menu">
                    {item.children.map(child => (
                      <li>
                        {'href' in child ? (
                          <a
                            class="navbar__link"
                            href={resolveHref(child.href)}
                            target={child.external ? '_blank' : undefined}
                            rel={child.external ? 'noopener noreferrer' : undefined}
                          >
                            {child.label}
                            {child.external && <ExternalLink size={14} aria-hidden="true" />}
                          </a>
                        ) : (
                          <span class="navbar__link">{child.label}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="navbar__right">
      <button
        class="navbar__toggle"
        type="button"
        aria-controls="tech-fair-navbar-menu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <Menu />
      </button>
    </div>
  </div>
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('.navbar');

  if (!navbar) {
    throw new Error('Tech Fair navbar script could not find the navbar element.');
  }

  const navbarElement = navbar;
  const toggleButton = navbarElement.querySelector<HTMLButtonElement>('.navbar__toggle');
  const closeButton = navbarElement.querySelector<HTMLButtonElement>('.navbar__close');
  const navLinks = navbarElement.querySelectorAll<HTMLAnchorElement>('a.navbar__link');
  const dropdownButtons = navbarElement.querySelectorAll<HTMLButtonElement>('.dropdown > button');

  function closeMenu() {
    navbarElement.classList.add('navbar--menu-animate');
    navbarElement.classList.remove('navbar--menu-open');
    toggleButton?.setAttribute('aria-expanded', 'false');
  }

  let isNavigating = false;

  function updateScrolledState() {
    if (!isNavigating) {
      navbarElement.classList.toggle('navbar--scrolled', window.scrollY > 0);
    }
  }

  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });
  document.addEventListener('astro:before-preparation', () => {
    isNavigating = true;
  });
  document.addEventListener('astro:page-load', () => {
    isNavigating = false;
    updateScrolledState();
  });

  toggleButton?.addEventListener('click', () => {
    navbarElement.classList.add('navbar--menu-animate');
    const isOpen = navbarElement.classList.toggle('navbar--menu-open');
    toggleButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  closeButton?.addEventListener('click', closeMenu);
  navLinks.forEach(link => link.addEventListener('click', closeMenu));

  dropdownButtons.forEach(button => {
    button.addEventListener('click', () => {
      const dropdown = button.closest('.dropdown');
      const isOpen = dropdown?.classList.toggle('dropdown--open') ?? false;
      button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  const resetMenuForViewport = () => {
    closeMenu();
    navbarElement.classList.remove('navbar--menu-animate');
    navbarElement.querySelectorAll('.dropdown--open').forEach(dropdown => {
      dropdown.classList.remove('dropdown--open');
    });
    dropdownButtons.forEach(button => button.setAttribute('aria-expanded', 'false'));
  };

  window.matchMedia('(max-width: 36rem)').addEventListener('change', resetMenuForViewport);
</script>

<style>
  .navbar {
    --nav-clr-bg: var(--clr-surface-base);
    --nav-clr-fg: var(--clr-surface-inverse);
    --menu-clr-bg: var(--clr-surface-inverse);
    --menu-clr-fg: var(--clr-surface-base);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--navbar-z-index);
    width: 100vw;
    height: var(--navbar-height);
    padding: 0 var(--sp-2);
    display: flex;
    align-items: center;
    color: var(--nav-clr-fg);
    background-color: var(--nav-clr-bg);
    transition:
      height var(--animation-duration-regular) ease,
      box-shadow var(--animation-duration-regular) ease;
  }

  .navbar__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-6);
    width: 100%;
    max-width: var(--site-content-width);
  }

  .navbar__nav {
    position: fixed;
    top: 0;
    right: 0;
    width: 16.5rem;
    max-width: 100vw;
    height: 100vh;
    padding: var(--sp-6);
    display: flex;
    justify-content: flex-start;
    flex-direction: column;
    gap: var(--sp-4);
    overflow-y: auto;
    z-index: 1;
    color: var(--menu-clr-fg);
    background-color: var(--menu-clr-bg);
    transform: translateX(100%);
  }

  .navbar--menu-animate .navbar__nav {
    transition: transform var(--animation-duration-regular) ease;
  }

  .navbar--menu-open .navbar__nav {
    transform: translateX(0);
  }

  .navbar--scrolled {
    --nav-clr-bg: var(--clr-surface-inverse);
    --nav-clr-fg: var(--clr-surface-base);
    height: var(--navbar-height-scrolled);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .navbar__left {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .navbar__title {
    font-size: var(--font-size-3);
    font-family: var(--font-title);
    white-space: nowrap;
  }

  .navbar__list {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .navbar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
    color: var(--menu-clr-fg);
  }

  .dropdown {
    position: relative;
  }

  .dropdown button {
    background: none;
    cursor: pointer;
    font-size: inherit;
  }

  .dropdown__menu {
    display: none;
    top: 100%;
    left: 0;
    flex-direction: column;
    gap: 0;
    min-width: 10rem;
    padding: 0 var(--sp-2);
    background-color: var(--menu-clr-bg);
  }

  .dropdown--open .dropdown__menu {
    display: flex;
  }

  .dropdown__menu li {
    width: 100%;
  }

  .dropdown__menu a {
    display: flex;
    padding: var(--sp-2) 0;
    white-space: nowrap;
  }

  .navbar__right {
    display: flex;
    justify-content: flex-end;
  }

  .navbar__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: var(--sp-2);
    background: none;
    cursor: pointer;
    color: inherit;
  }

  .navbar__menu-header {
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .navbar__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2);
    background: none;
    cursor: pointer;
    color: inherit;
  }

  @media (min-width: 36rem) {
    .navbar {
      --menu-clr-bg: var(--clr-surface-base);
      --menu-clr-fg: var(--clr-surface-inverse);
      justify-content: center;
      padding: 0;
    }

    .navbar__content {
      display: grid;
      grid-template-columns: 1fr 2fr 0;
      padding: 0 var(--sp-4);
    }

    .navbar__nav {
      position: static;
      width: auto;
      max-width: none;
      height: auto;
      padding: 0;
      background-color: transparent;
      justify-content: center;
      overflow: visible;
      transform: none;
      transition: none;
    }

    .navbar__list {
      flex-direction: row;
      justify-content: flex-end;
      gap: var(--sp-5);
    }

    .navbar__menu-header,
    .navbar__toggle {
      display: none;
    }

    .navbar--scrolled {
      --menu-clr-bg: var(--clr-surface-inverse);
      --menu-clr-fg: var(--clr-surface-base);
    }

    .dropdown__menu {
      position: absolute;
      border: 1px solid var(--menu-clr-fg);
    }

    .dropdown:hover .dropdown__menu,
    .dropdown:focus-within .dropdown__menu {
      display: flex;
    }
  }
</style>
