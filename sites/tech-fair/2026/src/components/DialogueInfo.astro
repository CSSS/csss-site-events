---
import Badge from '@csss-site-events/ui/components/Badge.astro';
import { type Dialogue } from '../config/site.types';
import { getBrandColour } from '@csss-site-events/ui/common.data';

interface Props {
  sections: Dialogue[];
}

const { sections } = Astro.props;
---

<div class="qa">
  {
    sections.map(({ first, second }, index) => (
      <div class="content">
        <Badge tone={getBrandColour(index)}>
          <h3>{first}</h3>
        </Badge>
        <div class="second">{second}</div>
      </div>
    ))
  }
</div>

<style>
  .qa {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  h3 {
    margin-bottom: 0;
  }

  .second {
    margin-top: var(--sp-4);
  }
</style>
