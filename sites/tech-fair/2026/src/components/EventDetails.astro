---
import Section from '@csss-site-events/ui/components/Section.astro';
import { Image } from 'astro:assets';
import InfoBubble from './InfoBubble.astro';
import { CalendarDays, Clock10, MapPin, UserStar, type Icon as IconType } from '@lucide/astro';
import event1 from '../assets/tf2025/event1.jpg';

interface Detail {
  heading: string;
  content: string;
  icon: typeof IconType;
  variant: 'red' | 'blue' | 'pink' | 'teal';
}

const details: Detail[] = [
  {
    heading: 'Date',
    content: 'November 4, 2026',
    icon: CalendarDays,
    variant: 'red'
  },
  {
    heading: 'Time',
    content: '10AM - 4PM',
    icon: Clock10,
    variant: 'blue'
  },
  {
    heading: 'Location',
    content: 'SFU Burnaby Campus, Applied Sciences Building',
    icon: MapPin,
    variant: 'pink'
  },
  {
    heading: 'Invitees',
    content: 'YOU!',
    icon: UserStar,
    variant: 'teal'
  }
];
---

<Section>
  <div class="photo-container" slot="left-gutter">
    <div class="photo">
      <Image src={event1} alt="Tech Fair 2023 Avigilon" width={800} />
    </div>
  </div>
  <div class="info">
    {
      details.map(({ heading, content, icon, variant }) => (
        <InfoBubble heading={heading} icon={icon} variant={variant}>
          {content}
        </InfoBubble>
      ))
    }
  </div>
</Section>

<style>
  @media (min-width: 36rem) {
    .photo {
      display: block;
    }

    .info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--sp-4);
    }
  }
</style>
