---
import { type Icon as IconType } from '@lucide/astro';

interface Props {
  heading: string;
  icon: typeof IconType;
  variant?: 'red' | 'blue' | 'pink' | 'teal';
}

const { heading, icon: Icon, variant = 'red' } = Astro.props;
---

<div class:list={['info-bubble', `brand--${variant}`]}>
  <div class="heading"><h3>{heading}</h3><Icon size={32} /></div>
  <p>
    <slot />
  </p>
</div>

<style>
  .heading {
    display: flex;
    justify-content: space-between;
  }

  .info-bubble {
    width: 100%;
    height: 9rem;
    padding: var(--sp-6);
    border-radius: var(--border-radius-default);
    margin: var(--sp-4) auto;
  }

  p {
    font-family: var(--font-heading);
    max-width: 16rem;
  }
</style>
