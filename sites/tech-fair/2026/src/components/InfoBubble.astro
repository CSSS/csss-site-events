---
import { type Icon as IconType } from '@lucide/astro';

interface Props {
  heading: string;
  icon: typeof IconType;
  variant?: 'red' | 'blue' | 'pink' | 'teal';
}

const { heading, icon: Icon, variant = 'red' } = Astro.props;
---

<div class:list={['info-bubble', `info-bubble--${variant}`]}>
  <div class="heading"><h3>{heading}</h3><Icon size={32} /></div>
  <p>
    <slot />
  </p>
</div>

<style>
  .heading {
    display: flex;
    justify-content: space-between;
  }

  .info-bubble {
    padding: var(--sp-6);
    border-radius: var(--sp-3);
    color: var(--clr-text-inverse);
    margin: var(--sp-4) auto;
  }

  .info-bubble--red {
    background-color: var(--clr-accent-red);
  }

  .info-bubble--blue {
    background-color: var(--clr-accent-blue);
  }

  .info-bubble--pink {
    background-color: var(--clr-accent-pink);
  }

  .info-bubble--teal {
    background-color: var(--clr-accent-teal);
  }

  p {
    font-family: var(--font-heading);
  }
</style>
