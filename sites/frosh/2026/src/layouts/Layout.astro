---
// BaseLayout must be at the top
import BaseLayout from '@csss-site-events/ui/layouts/BaseLayout.astro';
import '@csss-site-events/ui/styles/font-faces/cal-sans.css';
import '@csss-site-events/ui/styles/font-faces/geist-mono.css';
import '../styles.css';

import calSansFont from '@csss-site-events/ui/assets/fonts/cal-sans-v2-latin-regular.woff2?url';
import geistMonoRegularFont from '@csss-site-events/ui/assets/fonts/geist-mono-v6-latin-regular.woff2?url';
import Footer from '@csss-site-events/ui/components/Footer.astro';
import Hero from '@csss-site-events/ui/components/Hero.astro';
import Navbar from '@csss-site-events/ui/components/Navbar.astro';
import { type NavItem } from '@csss-site-events/ui/types';
import type { ImageMetadata } from 'astro';

import { navItems, siteConfig } from '../config/site.data';

interface Props {
  title: string;
  heroImage?: ImageMetadata;
  heroAlt?: string;
  heroBgColour?: string;
  isFullHeightHero?: boolean;
  navItems?: NavItem[];
}

const { title, heroImage, heroAlt, heroBgColour, isFullHeightHero = false } = Astro.props;
const hasHero = heroImage || Astro.slots.hero;
---

<BaseLayout pageTitle={title} description={siteConfig.description}>
  <Fragment slot="head">
    <link rel="preload" href={calSansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoRegularFont} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <Navbar title={title} items={navItems} />
  {
    hasHero ? (
      <Hero image={heroImage} alt={heroAlt} isFullHeight={isFullHeightHero} bgColor={heroBgColour}>
        <slot name="hero" />
      </Hero>
    ) : (
      <slot name="hero" />
    )
  }
  <main class="content-grid full-width">
    <slot />
  </main>
  <Footer config={siteConfig} navItems={navItems} />
</BaseLayout>

<style>
  main {
    width: 100%;
    row-gap: var(--section-gap);
    padding: var(--sp-6) 0;
  }
</style>
