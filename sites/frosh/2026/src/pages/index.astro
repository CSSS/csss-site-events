---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import banner from '../assets/banner-full-standard.png';
import bannerSmall from '../assets/banner-small-alt.png';
import Schedule from '../components/Schedule.astro';
import ResponsiveImage from '@csss-site-events/ui/components/ResponsiveImage.astro';
import About from '../components/About.astro';
import Organizers from '../components/Organizers.astro';
import Sponsors from '../components/Sponsors.astro';
---

<Layout title="Once Upon a Frosh" heroBgColour="#010101">
  <ResponsiveImage
    smallSrc={bannerSmall}
    largeSrc={banner}
    imgWidths={[1280, 1920]}
    imgHeights={[1440, 1080]}
    breakpoint={850}
    quality={90}
    alt="Frosh 2026 Banner"
    fetchPriority="high"
    slot="hero"
  />
  <About />
  <Schedule />
  <Organizers />
  <Sponsors />
  <Faq />
</Layout>
