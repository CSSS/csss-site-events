---
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  isFullHeight?: boolean;
  bgColor?: string;
}

const { image, isFullHeight, bgColor, alt = '' } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<section class:list={['hero', `hero${isFullHeight ? '--full-height' : ''}`]}
  style={bgColor ? `background-color: ${bgColor};` : undefined}
>
  {image && <Image class="hero__image" src={image} alt={alt} />}
  {hasContent && <slot />}
</section>

<style>
  @layer base {
    .hero {
      position: relative;
      width: 100vw;
      height: 10svh;
      overflow: hidden;
      margin-bottom: var(--section-gap);
      height: calc(100svh - var(--navbar-height));
    }

    .hero--full-height > .hero__image {
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
    }

    .hero__image {
      width: 100%;
    }
  }
</style>
