---
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  isFullHeight?: boolean;
  bgColor?: string;
}

const { image, isFullHeight, bgColor, alt = '' } = Astro.props;
const hasContent = Astro.slots.has('default');
---

<section
  class:list={[`hero${isFullHeight ? '--full-height' : ''}`]}
  style={bgColor ? `background-color: ${bgColor};` : undefined}
>
  {image && <Image class="hero__image" src={image} alt={alt} />}
  {hasContent && <slot />}
</section>

<style>
  @layer base {
    .hero,
    .hero--full-height {
      position: relative;
      width: 100vw;
      overflow: hidden;
      height: calc(100svh - var(--navbar-height));
    }

    .hero--full-height > .hero__image {
      height: 100%;
      object-fit: cover;
    }

    .hero__image {
      width: 100%;
    }
  }
</style>
