---
import { socialLinks } from '../../common.data';
import DiscordIcon from '../../icons/DiscordIcon.astro';
import type { BrandColour } from '../../types';
import Button from './Button.astro';

interface Props {
  tone?: BrandColour;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { tone, class: className, size = 'md', ...rest } = Astro.props;
---

<Button
  class:list={[className]}
  target="_blank"
  href={socialLinks.discord}
  tone={tone}
  size={size}
  {...rest}
>
  <DiscordIcon />Discord
</Button>
