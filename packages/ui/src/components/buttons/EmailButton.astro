---
import { Mail } from '@lucide/astro';

import type { BrandColour } from '../../types';
import Button from './Button.astro';

interface Props {
  address: string;
  tone?: BrandColour;
  class?: string;
}

const { address, tone = 'blue', class: className, ...rest } = Astro.props;
---

<Button class:list={[className]} target="_blank" href={`mailto:${address}`} tone={tone} {...rest}>
  <Mail /><slot>Email</slot>
</Button>
