---
import Button from '../Button.astro';
import { Mail } from '@lucide/astro';

interface Props {
  address: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'solid' | 'outline' | 'ghost';
  tone?: 'blue' | 'pink' | 'red' | 'green';
  size?: 'sm' | 'md' | 'lg';
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  class?: string;
}

const {
  address,
  type = 'button',
  variant = 'solid',
  tone = 'blue',
  size = 'md',
  rel,
  class: className,
  ...rest
} = Astro.props;
---

<Button target="_blank" href={`mailto:${address}`} tone={tone} {...rest}
  ><Mail /><slot>Email</slot></Button
>
