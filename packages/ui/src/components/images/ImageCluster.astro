---
import { Image } from 'astro:assets';
import Badge from '../Badge.astro';
import { type ImageClusterItem } from '../../types';

interface Props {
  images: ImageClusterItem[];
}

const { images } = Astro.props;

const optimizedPhotoWidthRem = 26;
---

<image-cluster class="cluster">
  {
    images.toReversed().map((image, index) => (
      <div class:list={['photo', { 'photo--eager': index === images.length - 1 }]}>
        <Image
          class:list={['photo__img', `index-${index + 1}`]}
          src={image.image}
          alt={image.alt}
          width={optimizedPhotoWidthRem * 16 * 2}
          loading={index === images.length - 1 ? 'eager' : 'lazy'}
        />
        {image.description && (
          <div class="photo__badge">
            <Badge tone="red" variant="outline">
              {image.description}
            </Badge>
          </div>
        )}
      </div>
    ))
  }
</image-cluster>

<style define:vars={{ optimizedPhotoWidthRem }}>
  .cluster {
    --photo-width: min(calc(var(--optimizedPhotoWidthRem) * 1rem), calc(100vw - 8rem));
    --photo-hover-lift: 12rem;
    position: relative;
    display: block;
    z-index: 0;
    top: 0;
    inline-size: min(100%, calc(var(--photo-width) + 10rem));
    block-size: calc(var(--photo-width) + var(--photo-hover-lift));
  }

  .photo {
    position: absolute;
    bottom: var(--photo-bottom);
    left: var(--photo-left);
    inline-size: var(--photo-width);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-radius: var(--corner-radius);
    padding: 0.5rem;
    rotate: 0deg;
    opacity: 0;
    transform: translate3d(var(--fan-start-x), var(--fan-start-y), 0);
    backface-visibility: hidden;
    will-change: transform, rotate;

    transition:
      rotate var(--animation-duration-regular) ease,
      transform var(--animation-duration-regular) ease;
    pointer-events: none;
  }

  .photo--eager,
  .cluster.is-loaded .photo {
    opacity: 1;
  }

  .cluster.is-loaded .photo {
    rotate: var(--deg);
    transform: translate3d(0, 0, 0);
  }

  .cluster.is-loaded:not(.is-fanned) .photo {
    transition-delay: calc(0.18s + var(--fan-delay, 0s));
  }

  .photo__img {
    pointer-events: auto;
  }

  .photo:nth-child(odd) {
    --deg: 5deg;
  }

  .photo:nth-child(even) {
    --deg: -2deg;
  }

  /* Firefox does not support `sibling-count()` yet */
  /* The photos are rendered in reverse order to that z-index is automatically managed,
     which means the image in front is actually the last sibling. */
  .photo:nth-child(3) {
    --photo-bottom: 0;
    --photo-left: 6rem;
    --fan-start-x: 0;
    --fan-start-y: 0;
    --badge-left: auto;
    --badge-right: -2rem;
    --fan-delay: 0.08s;
  }

  .photo:nth-child(2) {
    --photo-bottom: 4rem;
    --photo-left: 2rem;
    --fan-start-x: 4rem;
    --fan-start-y: 4rem;
    --badge-left: -2rem;
    --badge-right: auto;
    --fan-delay: 0.16s;
  }

  .photo:nth-child(1) {
    --photo-bottom: 8rem;
    --photo-left: 6rem;
    --fan-start-x: 0;
    --fan-start-y: 8rem;
    --badge-left: auto;
    --badge-right: -2rem;
    --fan-delay: 0.24s;
  }

  .photo__img {
    max-width: 100%;
    height: auto;
    border-radius: var(--corner-radius);
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .photo__badge {
    position: absolute;
    bottom: 0.75rem;
    left: var(--badge-left, auto);
    right: var(--badge-right, auto);
    opacity: 0;
    pointer-events: none;
    transform: rotate(calc(var(--deg) * -1));
    transform-origin: center;
  }

  .photo:hover {
    pointer-events: auto;
    transform: translate3d(0, calc(-1 * var(--photo-hover-lift)), 0);
    transition-delay: 0s;
  }

  .cluster.is-loaded .photo:hover {
    transform: translate3d(0, calc(-1 * var(--photo-hover-lift)), 0);
    transition-delay: 0s;
  }

  .photo:hover .photo__badge {
    opacity: 1;
  }

  /* This ensures the hover doesn't break when the photo hovers above the stack. */
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    bottom: calc(-100% - 4rem);
    pointer-events: none;
  }

  .photo:hover::after {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo,
    .cluster.is-loaded .photo {
      transition: none;
      transform: translate3d(0, 0, 0);
      rotate: var(--deg);
    }
  }
</style>

<script>
  class ImageClusterElement extends HTMLElement {
    private hasPlayed = false;
    private imagesAreLoaded = false;
    private isInViewportRange = false;
    private observer?: IntersectionObserver;

    connectedCallback() {
      if (this.hasPlayed || this.classList.contains('is-loaded')) {
        this.hasPlayed = true;
        return;
      }

      void this.waitForImages().then(() => {
        this.imagesAreLoaded = true;
        this.playWhenReady();
      });

      if (!('IntersectionObserver' in window)) {
        this.isInViewportRange = true;
        this.playWhenReady();
        return;
      }

      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting) {
            return;
          }

          this.isInViewportRange = true;
          this.observer?.disconnect();
          this.playWhenReady();
        },
        {
          rootMargin: '0px 0px -10% 0px',
          threshold: 0
        }
      );

      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }

    private waitForImages() {
      const images = Array.from(this.querySelectorAll<HTMLImageElement>('img'));

      const imageLoads = images.map(image => {
        if (image.complete) {
          return Promise.resolve();
        }

        return new Promise<void>(resolve => {
          image.addEventListener('load', () => resolve(), { once: true });
          image.addEventListener('error', () => resolve(), { once: true });
        });
      });

      return Promise.all(imageLoads);
    }

    private playWhenReady() {
      if (this.hasPlayed || !this.imagesAreLoaded || !this.isInViewportRange) {
        return;
      }

      this.hasPlayed = true;
      this.classList.add('is-loaded');
      window.setTimeout(() => {
        this.classList.add('is-fanned');
      }, 1200);
    }
  }

  if (!customElements.get('image-cluster')) {
    customElements.define('image-cluster', ImageClusterElement);
  }
</script>
