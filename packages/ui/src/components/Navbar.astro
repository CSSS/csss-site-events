---
import type { NavItem } from '../types';

interface Props {
  title: string;
  items?: NavItem[];
}

const { title, items = [] } = Astro.props;
---

<header class="navbar">
  <div class="navbar__left">
    <slot name="icon" />
    <span class="navbar__title">{title}</span>
  </div>
  <nav class="navbar__nav">
    <ul>
      {
        items.map(item => (
          <li>
            {'href' in item ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <div class="dropdown">
                <button>{item.label}</button>
                <ul class="dropdown__menu">
                  {item.dropdown.map(child => (
                    <li>
                      {'href' in child ? (
                        <a href={child.href}>{child.label}</a>
                      ) : (
                        <span>{child.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const navbar = document.querySelector('.navbar') as HTMLElement;

  // If the user has scrolled down the navbar recedes a bit
  const observer = new IntersectionObserver(
    ([entry]) => {
      navbar.classList.toggle('navbar--scrolled', !entry.isIntersecting);
    },
    { threshold: 0 }
  );

  const sentinel = document.createElement('div');
  sentinel.style.position = 'absolute';
  sentinel.style.top = '0';
  document.body.prepend(sentinel);
  observer.observe(sentinel);
</script>

<style>
  :root {
    --navbar-height: 5rem;
    --navbar-height-scrolled: calc(var(--navbar-height) - 2rem);
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;

    display: flex;
    align-items: center;

    gap: 0.75rem;
    padding: 0 2rem;
    height: var(--navbar-height);
    transition:
      height 0.3s ease,
      box-shadow 0.3s ease;
  }

  .navbar--scrolled {
    height: var(--navbar-height-scrolled);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .navbar__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .navbar__title {
    font-size: 1.1rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .navbar__nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar__nav a {
    text-decoration: none;
  }

  .dropdown {
    position: relative;
  }

  .dropdown button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: inherit;
    padding: 0;
  }

  .dropdown__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    flex-direction: column;
    gap: 0;
    min-width: 10rem;
    padding: 0.5rem 0;
  }

  .dropdown:hover .dropdown__menu,
  .dropdown:focus-within .dropdown__menu {
    display: flex;
  }

  .dropdown__menu li {
    width: 100%;
    list-style: none;
  }

  .dropdown__menu a {
    display: block;
    padding: 0.5rem 1rem;
    white-space: nowrap;
  }
</style>
