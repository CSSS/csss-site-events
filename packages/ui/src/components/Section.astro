---
interface Props {
  id?: string;
  title?: string;
}

const { id, title } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<section id={id} class="section">
  <div class="section__content">
    <aside class="section__content__left">
      <slot name="left-gutter" />
    </aside>
    <div class="section__content__main">
      <slot name="header">
        <h2 class="section__heading">{title}</h2>
      </slot>
      <slot />
    </div>
    <aside class="section__content__right">
      <slot name="right-gutter" />
    </aside>
  </div>
  {
    hasFooter && (
      <div class="section__footer">
        <slot name="footer" />
      </div>
    )
  }
</section>

<style>
  .section__content__main {
    max-width: var(--site-content-width);
  }

  .section__content__right,
  .section__content__left {
    display: none;
  }

  .section__footer {
    display: flex;
    margin-top: var(--sp-4);
    justify-content: center;
    gap: var(--sp-4);
  }

  h2 {
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 36rem) {
    .section__content {
      display: flex;
      align-items: flex-start;
    }

    .section__content__right,
    .section__content__left {
      display: block;
      flex: 1;
      min-width: 0;
    }
  }
</style>
