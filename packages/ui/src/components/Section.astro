---
interface Props {
  id?: string;
  title?: string;
}

const { id, title } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<section id={id} class="section">
  <slot name="header">
    <h2 class="section__heading">{title}</h2>
  </slot>
  <slot />
  {
    hasFooter && (
      <div class="section__footer">
        <slot name="footer" />
      </div>
    )
  }
</section>

<style>
  .section__footer {
    display: flex;
    margin-top: var(--sp-4);
    justify-content: center;
    gap: var(--sp-4);
  }
</style>
