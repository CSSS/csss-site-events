---
interface Props {
  id?: string;
  title?: string;
}

const { id, title } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<section id={id} class="content-grid full-width">
  <div class="section__content content-grid full-width">
    <aside class="section__content__left">
      <slot name="left-gutter" />
    </aside>
    <div>
      <slot name="header">
        <h2 class="section__heading">{title}</h2>
      </slot>
      <slot />
    </div>
    <aside class="section__content__right">
      <slot name="right-gutter" />
    </aside>
  </div>
  {
    hasFooter && (
      <div class="section__footer">
        <slot name="footer" />
      </div>
    )
  }
</section>

<style>
  section {
    container-type: inline-size;
  }

  .section__content__right,
  .section__content__left {
    display: none;
    position: relative;
  }

  .section__content__left {
    grid-column: full-width / content-start;
  }

  .section__content__right {
    grid-column: content-end / full-width-end;
  }

  .section__footer {
    display: flex;
    margin-top: var(--sp-4);
    justify-content: center;
    gap: var(--sp-4);
  }

  h2 {
    margin-bottom: var(--sp-4);
  }

  @container (min-width: 120rem) {
    .section__content__right,
    .section__content__left {
      display: block;
    }
  }
</style>
