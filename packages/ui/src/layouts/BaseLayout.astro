---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import { NavItem } from '../types';

interface Props {
  title: string;
  navItems: NavItem[];
}

const { title, navItems } = Astro.props;

const hasHero = Astro.slots.has('hero');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar title={title} items={navItems} />
    {
      hasHero && (
        <Hero>
          <slot name="hero" />
        </Hero>
      )
    }
    <main>
      <slot />
    </main>
    <footer>
      <p>Base Layout Footer</p>
    </footer>
  </body>
</html>

<style>
  main {
    height: 200svh;
  }
</style>
